{
  "trailingSlash": true,
  "ignoreCommand": "BASE=${VERCEL_GIT_PREVIOUS_SHA:-HEAD^}; git cat-file -e \"$BASE^{commit}\" 2>/dev/null || exit 1; git diff --quiet \"$BASE\" HEAD -- . ':(exclude)editor'",
  "redirects": [
    { "source": "/t6", "destination": "/enrichment/#golf" },
    { "source": "/t6/", "destination": "/enrichment/#golf" },
    { "source": "/golf", "destination": "/enrichment/#golf" },
    { "source": "/golf/", "destination": "/enrichment/#golf" },
    { "source": "/waitlist", "destination": "/microschool/#visit" },
    { "source": "/waitlist/", "destination": "/microschool/#visit" },
    { "source": "/contact", "destination": "/#visit" },
    { "source": "/contact/", "destination": "/#visit" }
  ]
}
